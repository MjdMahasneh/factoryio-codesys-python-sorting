
{attribute 'qualified_only'}

VAR_GLOBAL

    // ========================================
    // 1. CONVEYOR CONTROL
    // ========================================

    // Controls the entry conveyor (first conveyor)
    // TRUE = running, FALSE = stopped
    oEntryConveyor : BOOL := FALSE;

    // Controls the exit conveyor (second conveyor)
    oExitConveyor : BOOL := FALSE;


    // ========================================
    // 2. ENCODER INPUT SIGNALS
    // ========================================

    // Entry conveyor encoder signals from Factory I/O
    // A and B are digital quadrature signals.
    // Current PLC logic counts rising edges of A only.
    iEncoderA : BOOL := FALSE;
    iEncoderB : BOOL := FALSE;

    // Exit conveyor encoder signals from Factory I/O
    // Current PLC logic counts rising edges of A only.
    iExitEncoderA : BOOL := FALSE;
    iExitEncoderB : BOOL := FALSE;


    // ========================================
    // 3. ENCODER POSITION COUNTERS
    // ========================================

    // Number of detected encoder A rising edges
    // on the entry conveyor
    entryEncoderCount : DINT := 0;

    // Number of detected encoder A rising edges
    // on the exit conveyor
    exitEncoderCount : DINT := 0;


    // ========================================
    // 4. OBJECT TRACKING STATISTICS
    // ========================================

    // Number of objects currently tracked on either conveyor
    pendingObjects : INT := 0;

    // Number of sorter commands issued for tracked objects
    sortedObjects : DINT := 0;


    // ========================================
    // 5. ENCODER DISTANCE CALIBRATION
    // ========================================

    // Entry conveyor:
    // Number of encoder counts between the vision sensor
    // and the transfer point onto the exit conveyor.
    //
    // Calibration:
    // transfer count - vision sensor count
    visionToTransferCounts : DINT := 3;

    // Exit conveyor:
    // Number of encoder counts between the transfer point
    // and each of the three sorting mechanisms.
    //
    // Calibration:
    // sorter count - transfer count
    //
    // Sorter 1 = Blue / PET plastic
    // Sorter 2 = Green / HDPE plastic
    // Sorter 3 = Metal / Aluminium
    sorter1Offset : DINT := 2;
    sorter2Offset : DINT := 14;
    sorter3Offset : DINT := 26;


    // ========================================
    // 6. SORTER ACTIVATION DURATION
    // ========================================

    // Duration for which the sorter turning mechanism
    // remains commanded ON after receiving a trigger.
    //
    // T#500ms = 500 milliseconds (0.5 seconds)
    // Used by the TP pulse timers in PLC_PRG.
    sorterTurnDuration : TIME := T#500ms;


    // ========================================
    // 7. MATERIAL CLASSIFICATION
    // ========================================

    // Raw vision sensor value received from Factory I/O
    // through Modbus holding register 0.
    materialSensorValue : WORD := 0;

    // Material classification generated by Python
    // and written through Modbus holding register 1.
    //
    // 0 = Unknown / no object
    // 1 = PET plastic (blue)
    // 2 = HDPE plastic (green)
    // 3 = Aluminium (metal)
    pythonMaterialClass : WORD := 0;

    // Integer representation of Python's classification
    // used internally by the PLC sorting logic
    materialClass : INT := 0;


    // ========================================
    // 8. SORTER ACTUATOR OUTPUTS
    // ========================================

    // Sorter 1 - PET plastic / Blue
    // Turn controls the sorting arm.
    // Belt controls the sorter's conveyor belt.
    oSorter1Turn : BOOL := FALSE;
    oSorter1Belt : BOOL := FALSE;

    // Sorter 2 - HDPE plastic / Green
    oSorter2Turn : BOOL := FALSE;
    oSorter2Belt : BOOL := FALSE;

    // Sorter 3 - Aluminium / Metal
    oSorter3Turn : BOOL := FALSE;
    oSorter3Belt : BOOL := FALSE;

END_VAR
